        <mxCell id="e5" value="④ 应用卡片查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.15;" edge="1" parent="1" source="pbff" target="doms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="220" /><mxPoint x="680" y="530" /></Array></mxGeometry></mxCell>
