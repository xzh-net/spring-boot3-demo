        <mxCell id="s2" value="凭据校验" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;strokeColor=#666666;fontColor=#666666;exitX=0.75;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="authC" source="login" target="idb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3" value="自省" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;strokeColor=#666666;fontColor=#666666;exitX=0.2;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="authC" source="adminapi" target="redisd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4" value="CRUD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;strokeColor=#666666;fontColor=#666666;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="authC" source="adminapi" target="idb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5" value="读写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=9;strokeColor=#666666;fontColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="resC" source="doms" target="rbacd"><mxGeometry relative="1" as="geometry" /></mxCell>
