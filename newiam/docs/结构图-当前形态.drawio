        <mxCell id="e8" value="⑥ 管理透传 /api/admin/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.77;entryX=1;entryY=0.3;" edge="1" parent="1" source="abff" target="adminapi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="225" /><mxPoint x="660" y="593" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="⑦ 透传 权限·应用·策略·能力" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.92;entryX=0;entryY=0.45;" edge="1" parent="1" source="abff" target="doms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="241" /><mxPoint x="700" y="575" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="⑧ opaque 自省 introspect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.15;exitY=0;entryX=0.82;entryY=0;" edge="1" parent="1" source="intro" target="proto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="286" /><mxPoint x="523" y="286" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="⑨ 登录期取角色 M2M · 失败降级猜测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.72;" edge="1" parent="1" source="login" target="doms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="492" /><mxPoint x="730" y="616" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="⑩ 删用户联动 admin-m2m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;strokeColor=#B85450;fontColor=#B85450;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.9;" edge="1" parent="1" source="adminapi" target="doms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="631" /><mxPoint x="765" y="643" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="⑪ 协议直连" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.6;" edge="1" parent="1" source="u_d" target="proto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="75" /><mxPoint x="720" y="389" /></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="⑫ 开放能力调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;exitX=0.35;exitY=1;entryX=1;entryY=0.35;" edge="1" parent="1" source="u_d" target="doms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1585" y="560" /></Array></mxGeometry></mxCell>
