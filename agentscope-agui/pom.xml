<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>net.xzh.agui</groupId>
    <artifactId>agentscope-agui</artifactId>
    <packaging>jar</packaging>

    <name>AgentScope Examples - AG-UI</name>
    <description>AG-UI Protocol example with frontend integration</description>

	<properties>
        <java.version>17</java.version>
        <agentscope.version>1.0.11</agentscope.version>
    </properties>
    
    <dependencies>
        <!-- AgentScope Core -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- AgentScope agui -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-agui</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- AG-UI WebFlux Spring Boot Starter -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-agui-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- Spring Boot WebFlux -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        
        <dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-a2a-spring-boot-starter</artifactId>
			<version>${agentscope.version}</version>
		</dependency>
		
		<!-- Nacos Client -->
        <dependency>
		    <groupId>com.alibaba.nacos</groupId>
		    <artifactId>nacos-client</artifactId>
		    <version>3.2.1</version>
		    <scope>compile</scope>
		</dependency>
    </dependencies>

</project>

